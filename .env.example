APP_ENV=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/support_tickets

AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
SQS_QUEUE_URL=http://localstack:4566/000000000000/ticket-processing

WORKER_POLL_WAIT_SECONDS=20
WORKER_MAX_MESSAGES=10

# Required by the LocalStack image. Get a free token at:
# https://app.localstack.cloud/getting-started
LOCALSTACK_AUTH_TOKEN=
